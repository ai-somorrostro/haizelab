# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno para la infraestructura InfluxDB + Node-RED
# Copia este fichero como .env y rellena los valores antes de arrancar.
# NUNCA subas .env a git.
# ──────────────────────────────────────────────────────────────────────────────

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_ORG=haizenlab
INFLUXDB_BUCKET_PRINCIPAL=aire
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=cambia_esta_contrasena_segura
INFLUXDB_ADMIN_TOKEN=cambia_este_token_admin_muy_largo_y_aleatorio

# ── Tokens de servicio (generados automáticamente) ───────────────────────────
# NO es necesario definir estos tokens aquí. El servicio influxdb_setup los
# genera automáticamente en el primer arranque con los permisos exactos y los
# deposita en el volumen compartido influxdb_tokens (/tokens/tokens.env).
# INFLUXDB_NODERED_WRITE_TOKEN=(autogenerado: solo escritura en meteo, trafico, aire_demo)
# INFLUXDB_BATCH_WRITE_TOKEN=(autogenerado: solo escritura en aire para carga_historica.py)
# INFLUXDB_READ_TOKEN=(autogenerado: solo lectura para Grafana / MCP)

# ── Retencion de buckets (en segundos; 0 = infinita) ─────────────────────────
# aire: infinita (datos historicos ZBE)
# meteo: infinita (0) para preservar historico 2022-2026 cargado en batch y datos en directo
# trafico: 30 dias = 2592000 s
# aire_demo: 7 dias = 604800 s
INFLUXDB_RETENTION_METEO=0
INFLUXDB_RETENTION_TRAFICO=2592000
INFLUXDB_RETENTION_AIRE_DEMO=604800

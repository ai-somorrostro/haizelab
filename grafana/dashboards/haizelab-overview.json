          "query": "from(bucket: \"$bucket_aire\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"contaminantes\")\n  |> filter(fn: (r) => r[\"_field\"] == \"no2\")\n  |> group()\n  |> mean()\n  |> map(fn: (r) => ({r with _field: \"Media NO2\"}))\n  |> yield(name: \"media\")",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB-HaizeLab"

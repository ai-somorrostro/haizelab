          "query": "from(bucket: \"$bucket_aire\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"contaminantes\")\n  |> filter(fn: (r) => r[\"_field\"] == \"no2\")\n  |> group()\n  |> quantile(q: 0.9)\n  |> map(fn: (r) => ({r with _field: \"Percentil 90\"}))\n  |> yield(name: \"p90\")",
          "refId": "B"
